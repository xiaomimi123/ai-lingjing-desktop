# 灵境桌面 v1 环境变量模板。复制为 .env 后填写。
# .env 在 .gitignore 里，不会被提交。

# 应用元信息
VITE_APP_TITLE=灵境
VITE_APP_VERSION=1.0.0

# OpenClaw Gateway 连接（默认即可，OpenClaw daemon 自管 token）
OPENCLAW_WS_URL=ws://localhost:18789
OPENCLAW_AUTH_TOKEN=

# 后端端口（Vite 前端跑 3001 / Express 后端跑 3000）
PORT=3000
DEV_PORT=3001

# 本地后端管理员凭据（前端 LoginGate 弹框输入）
# 仅本地访问 / 仅用于阻挡同机其他用户。生产环境请改强口令。
AUTH_USERNAME=admin
AUTH_PASSWORD=admin

LOG_LEVEL=INFO
