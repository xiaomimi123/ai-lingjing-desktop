{
  "name": "ai-lingjing-desktop",
  "productName": "灵境",
  "private": false,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "description": "灵境桌面 — Mac 上的 AI Agent 行动平台，让 AI 真正能操作你的电脑。基于 OpenClaw + Electron + React。",
  "author": "lizhishaoniange",
  "homepage": "https://github.com/xiaomimi123/ai-lingjing-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaomimi123/ai-lingjing-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/xiaomimi123/ai-lingjing-desktop/issues"
  },
  "keywords": [
    "ai-agent",
    "electron",
    "openclaw",
    "desktop",
    "macos",
    "react",
    "lingjing"
  ],
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --env-file=.env server/index.js",
    "dev:all": "concurrently -n \"frontend,backend\" -c \"blue,green\" \"vite\" \"node --env-file=.env server/index.js\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node --env-file=.env server/index.js",
    "electron": "electron .",
    "electron:dev": "concurrently -k -n \"frontend,electron\" -c \"blue,magenta\" \"vite\" \"wait-on tcp:3001 && electron .\"",
    "electron:build": "tsc -b && vite build",
    "dist:mac": "npm run electron:build && electron-builder --mac && npm rebuild better-sqlite3",
    "dist:win": "npm run electron:build && electron-builder --win && npm rebuild better-sqlite3",
    "dist:win:dryrun": "npm run electron:build && electron-builder --win --dir",
    "test:e2e": "node --env-file-if-exists=.env.test ./node_modules/.bin/playwright test",
    "test:e2e:headed": "node --env-file-if-exists=.env.test ./node_modules/.bin/playwright test --headed",
    "test:e2e:ui": "node --env-file-if-exists=.env.test ./node_modules/.bin/playwright test --ui",
    "test:report": "playwright show-report"
  },
  "build": {
    "appId": "com.lingjing.desktop",
    "productName": "灵境",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "node_modules/**/*",
      "!node_modules/**/test/**",
      "!node_modules/**/*.md"
    ],
    "extraResources": [
      "data/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "executableName": "lingjing",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "灵境"
    },
    "win": {
      "executableName": "lingjing",
      "icon": "public/lingjing.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "灵境",
      "uninstallDisplayName": "灵境 ${version}"
    },
    "portable": {
      "artifactName": "灵境-${version}-portable.exe"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@noble/ed25519": "^3.0.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/katex": "^0.16.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "axios": "^1.15.2",
    "better-sqlite3": "^12.9.0",
    "check-disk-space": "^3.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "edge-tts-client": "^1.0.2",
    "express": "^5.2.1",
    "framer-motion": "^11.15.0",
    "highlight.js": "^11.11.1",
    "i18next": "^24.0.5",
    "i18next-browser-languagedetector": "^8.0.2",
    "iconoir-react": "^7.11.0",
    "js-yaml": "^4.1.1",
    "katex": "^0.16.44",
    "markdown-it": "^14.1.1",
    "multer": "^2.0.2",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.2.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.28.0",
    "react-syntax-highlighter": "^15.6.1",
    "remark-gfm": "^4.0.0",
    "sonner": "^1.7.1",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^2.5.5",
    "tar": "^7.5.11",
    "unzipper": "^0.12.3",
    "uuid": "^13.0.0",
    "ws": "^8.19.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "electron": "^36.9.5",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.0",
    "eventsource": "^4.1.0",
    "playwright": "^1.58.2",
    "postcss": "^8.4.49",
    "prebuild-install": "^7.1.2",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^4.0.0",
    "wait-on": "^8.0.5"
  }
}
